# Supabase credentials (set in Cloudflare Pages dashboard under Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin portal passkey — set a strong secret to enable /admin access.
# If not set, the admin login page will display an error and deny all access.
NEXT_PUBLIC_ADMIN_PASSKEY=your_secret_admin_passkey_here
